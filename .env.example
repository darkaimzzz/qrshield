# All variables are optional. QRShield runs fully without any of them.
# Server-side only: none of these are exposed to the browser.

# Disable every outbound check (redirects, RDAP, threat intel, LLM). Used by the e2e tests.
# QRSHIELD_DISABLE_NETWORK=1

# Google Safe Browsing Lookup API v4 key (https://developers.google.com/safe-browsing).
# GSB_API_KEY=

# abuse.ch URLhaus API key (free: https://auth.abuse.ch/).
# URLHAUS_AUTH_KEY=

# OpenPhish community feed. Its terms allow only non-commercial research use, so it is opt-in.
# OPENPHISH_ENABLED=1

# Phishing.Database (MIT) is enabled by default; set to 1 to turn it off.
# PHISHING_DATABASE_DISABLED=1

# Optional LLM rewording of the explanation (any OpenAI-compatible /chat/completions API).
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=https://api.openai.com/v1
